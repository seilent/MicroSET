file(READ "${INPUT}" json)
set(patterns)
foreach(glob IN LISTS DROP)
    string(REPLACE "." "\\." pattern "${glob}")
    string(REPLACE "*" ".*" pattern "${pattern}")
    list(APPEND patterns "^${pattern}$")
endforeach()

string(JSON count LENGTH "${json}" keys)
math(EXPR last "${count} - 1")
set(names)
foreach(i RANGE ${last})
    string(JSON name MEMBER "${json}" keys ${i})
    list(APPEND names "${name}")
endforeach()
set(used)
set(hits)
foreach(name IN LISTS names)
    set(dropped OFF)
    foreach(pattern IN LISTS patterns)
        if(name MATCHES "${pattern}")
            set(dropped ON)
            list(APPEND hits "${pattern}")
        endif()
    endforeach()
    if(dropped)
        string(JSON json REMOVE "${json}" keys "${name}")
    else()
        string(JSON group ERROR_VARIABLE none GET "${json}" keys "${name}" group)
        if(NOT none)
            list(APPEND used "${group}")
        endif()
    endif()
endforeach()
foreach(glob IN LISTS DROP)
    list(POP_FRONT patterns pattern)
    if(NOT pattern IN_LIST hits)
        message(FATAL_ERROR "MICROSET_SCHEMA_DROP: ${glob} matches no key")
    endif()
endforeach()

string(JSON count LENGTH "${json}" groups)
math(EXPR last "${count} - 1")
set(groups)
foreach(i RANGE ${last})
    string(JSON group MEMBER "${json}" groups ${i})
    list(APPEND groups "${group}")
endforeach()
foreach(group IN LISTS groups)
    if(NOT group IN_LIST used)
        string(JSON json REMOVE "${json}" groups "${group}")
    endif()
endforeach()

file(WRITE "${OUTPUT}" "${json}\n")
