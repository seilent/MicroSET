[Unit]
Description=MicroSET settings
After=microos-powerd.service alsa-restore.service alsa-state.service sound.target
Before=display-manager.service
StartLimitIntervalSec=120
StartLimitBurst=30

[Service]
Type=dbus
BusName=net.seilent.MicroSet
ExecStart=@MICROSET_LIBEXEC@/microsetd
User=microset
Group=microset
SupplementaryGroups=audio dialout
StateDirectory=microset
StateDirectoryMode=0700
RuntimeDirectory=microset
RuntimeDirectoryPreserve=yes
TimeoutStartSec=10
Restart=always
RestartSec=1
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_QIPCRTR
DevicePolicy=closed
DeviceAllow=char-alsa rw
DeviceAllow=/dev/ttyHS2 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
