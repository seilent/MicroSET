    "power.profile": {
      "type": "s",
      "default": "balanced",
      "enum": ["low-power", "balanced", "performance"],
      "applier": "power",
      "group": "power",
      "label": "Performance profile",
      "ui": {"order": 0, "values": {"low-power": "low power"}}
    },
    "power.gpu_level": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "manual"],
      "applier": "power",
      "group": "power",
      "label": "GPU clock control",
      "ui": {"order": 3}
    },
    "power.gpu_clock": {
      "type": "u",
      "default": 587,
      "min": 305,
      "max": 587,
      "applier": "power",
      "group": "power",
      "label": "Manual GPU clock",
      "ui": {"order": 4, "steps": [305, 400, 442, 490, 525, 587], "values": {"442": "441.6 mhz"}, "unit": "mhz", "lock": {"key": "power.gpu_level", "is": "auto", "text": "auto"}}
    },
    "power.game_floor": {
      "type": "u",
      "default": 68,
      "min": 0,
      "max": 83,
      "applier": "power",
      "group": "power",
      "label": "Game CPU floor",
      "ui": {"order": 5, "steps": [0, 28, 49, 68, 83], "values": {"0": "off"}, "unit": "%"}
