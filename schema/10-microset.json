{
  "owner": "microset",
  "keys": {
    "power.profile": {
      "type": "s",
      "default": "balanced",
      "enum": ["low-power", "balanced", "performance"],
      "applier": "power",
      "group": "power",
      "label": "Performance profile"
    },
    "power.gpu_level": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "manual"],
      "applier": "power",
      "group": "power",
      "label": "GPU clock control"
    },
    "power.gpu_clock": {
      "type": "u",
      "default": 587,
      "min": 305,
      "max": 587,
      "applier": "power",
      "group": "power",
      "label": "Manual GPU clock (MHz)"
    },
    "power.governor": {
      "type": "s",
      "default": "schedutil",
      "enum": ["ondemand", "performance", "schedutil"],
      "applier": "power",
      "group": "power",
      "label": "CPU governor"
    },
    "power.tdp": {
      "type": "u",
      "default": 10,
      "min": 3,
      "max": 10,
      "applier": "power",
      "group": "power",
      "label": "TDP limit (W)"
    },
    "meta.imported_power": {
      "type": "b",
      "default": false,
      "writable": false,
      "applier": null,
      "group": null,
      "label": "Power settings imported from powerd"
    },
    "session.default": {
      "type": "s",
      "default": "steam",
      "enum_from": "sessions",
      "applier": null,
      "group": "system",
      "label": "Boot into"
    },
    "audio.output": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "speaker", "headphones", "usb", "bt"],
      "applier": null,
      "group": "audio",
      "label": "Output"
    },
    "audio.hp_gain": {
      "type": "s",
      "default": "high",
      "enum": ["low", "normal", "high"],
      "applier": "alsa",
      "group": "audio",
      "label": "Headphone gain"
    },
    "audio.hp_amp": {
      "type": "s",
      "default": "lohifi",
      "enum": ["lohifi", "ulp", "hifi"],
      "applier": "alsa",
      "group": "audio",
      "label": "Headphone amp"
    },
    "audio.speaker_gain": {
      "type": "u",
      "default": 102,
      "enum": [84, 90, 96, 99, 102, 105, 108],
      "applier": "alsa",
      "group": "audio",
      "label": "Speaker digital gain"
    },
    "audio.volume_step": {
      "type": "u",
      "default": 5,
      "enum": [2, 5, 10],
      "applier": null,
      "group": "audio",
      "label": "Volume step"
    },
    "audio.eq.headphones.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ"
    },
    "audio.eq.headphones.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ profile"
    },
    "audio.eq.headphones.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ filters"
    },
    "audio.eq.speaker.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ"
    },
    "audio.eq.speaker.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ profile"
    },
    "audio.eq.speaker.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ filters"
    },
    "audio.eq.usb.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "USB EQ"
    },
    "audio.eq.usb.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "USB EQ profile"
    },
    "audio.eq.usb.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "USB EQ filters"
    },
    "audio.eq.bt.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ"
    },
    "audio.eq.bt.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ profile"
    },
    "audio.eq.bt.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ filters"
    },
    "audio.bt_codec": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "aptx", "aac", "ldac", "sbc"],
      "applier": null,
      "group": "audio",
      "label": "Bluetooth codec"
    },
    "display.orientation": {
      "type": "s",
      "default": "portrait",
      "enum": ["portrait", "portrait-flipped", "landscape", "landscape-flipped"],
      "applier": "ssc",
      "group": "display",
      "label": "Orientation"
    },
    "display.auto_rotate": {
      "type": "b",
      "default": true,
      "applier": "ssc",
      "group": "display",
      "label": "Auto rotate"
    },
    "display.rotation": {
      "type": "s",
      "default": "portrait",
      "enum": ["portrait", "portrait-flipped", "landscape", "landscape-flipped"],
      "writable": false,
      "applier": "ssc",
      "group": null,
      "label": "Current rotation"
    },
    "rgb.enabled": {
      "override": true,
      "type": "b",
      "default": false,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LEDs"
    },
    "rgb.color": {
      "override": true,
      "type": "u",
      "default": 16777215,
      "min": 0,
      "max": 16777215,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LED color (0xRRGGBB)"
    },
    "rgb.brightness": {
      "override": true,
      "type": "u",
      "default": 64,
      "min": 0,
      "max": 255,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LED brightness"
    }
  }
}
