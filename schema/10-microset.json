{
  "owner": "microset",
  "keys": {
    "power.profile": {
      "type": "s",
      "default": "balanced",
      "enum": ["low-power", "balanced", "performance"],
      "applier": "power",
      "group": "power",
      "label": "Performance profile",
      "ui": {"order": 0, "values": {"low-power": "low power"}}
    },
    "power.gpu_level": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "manual"],
      "applier": "power",
      "group": "power",
      "label": "GPU clock control",
      "ui": {"order": 3}
    },
    "power.gpu_clock": {
      "type": "u",
      "default": 587,
      "min": 305,
      "max": 587,
      "applier": "power",
      "group": "power",
      "label": "Manual GPU clock",
      "ui": {"order": 4, "steps": [305, 400, 442, 490, 525, 587], "values": {"442": "441.6 mhz"}, "unit": "mhz", "lock": {"key": "power.gpu_level", "is": "auto", "text": "auto"}}
    },
    "power.governor": {
      "type": "s",
      "default": "schedutil",
      "enum": ["ondemand", "performance", "schedutil"],
      "applier": "power",
      "group": "power",
      "label": "CPU governor",
      "ui": {"order": 2}
    },
    "power.tdp": {
      "type": "u",
      "default": 10,
      "min": 3,
      "max": 10,
      "applier": "power",
      "group": "power",
      "label": "TDP limit",
      "ui": {"order": 1, "step": 1, "unit": "w"}
    },
    "meta.imported_power": {
      "type": "b",
      "default": false,
      "writable": false,
      "applier": null,
      "group": null,
      "label": "Power settings imported from powerd"
    },
    "session.default": {
      "type": "s",
      "default": "steam",
      "enum_from": "sessions",
      "applier": null,
      "group": "system",
      "label": "Boot into",
      "ui": {"order": 0, "apply": "confirm"}
    },
    "audio.output": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "speaker", "headphones", "usb", "bt"],
      "applier": null,
      "group": "audio",
      "label": "Output",
      "ui": {"order": 0}
    },
    "audio.hp_gain": {
      "type": "s",
      "default": "high",
      "enum": ["low", "normal", "high"],
      "applier": "alsa",
      "group": "audio",
      "label": "Headphone gain",
      "ui": {"order": 1}
    },
    "audio.hp_amp": {
      "type": "s",
      "default": "lohifi",
      "enum": ["lohifi", "ulp", "hifi"],
      "applier": "alsa",
      "group": "audio",
      "label": "Headphone amp",
      "ui": {"order": 2}
    },
    "audio.speaker_gain": {
      "type": "u",
      "default": 102,
      "enum": [84, 90, 96, 99, 102, 105, 108],
      "applier": "alsa",
      "group": "audio",
      "label": "Speaker digital gain",
      "ui": {"order": 3, "values": {"84": "0 db", "90": "+6 db", "96": "+12 db", "99": "+15 db", "102": "+18 db", "105": "+21 db", "108": "+24 db"}}
    },
    "audio.volume_step": {
      "type": "u",
      "default": 5,
      "enum": [2, 5, 10],
      "applier": null,
      "group": "audio",
      "label": "Volume step",
      "ui": {"order": 4, "values": {"2": "2%", "5": "5%", "10": "10%"}}
    },
    "audio.eq.headphones.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ",
      "ui": {"order": 6}
    },
    "audio.eq.headphones.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ profile",
      "ui": {"order": 7}
    },
    "audio.eq.headphones.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Headphones EQ filters",
      "ui": {"widget": "none"}
    },
    "audio.eq.speaker.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ",
      "ui": {"order": 8}
    },
    "audio.eq.speaker.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ profile",
      "ui": {"order": 9}
    },
    "audio.eq.speaker.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Speaker EQ filters",
      "ui": {"widget": "none"}
    },
    "audio.eq.usb.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "USB EQ",
      "ui": {"order": 10}
    },
    "audio.eq.usb.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "USB EQ profile",
      "ui": {"order": 11}
    },
    "audio.eq.usb.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "USB EQ filters",
      "ui": {"widget": "none"}
    },
    "audio.eq.bt.on": {
      "type": "b",
      "default": false,
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ",
      "ui": {"order": 12}
    },
    "audio.eq.bt.name": {
      "type": "s",
      "default": "",
      "max_len": 256,
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ profile",
      "ui": {"order": 13}
    },
    "audio.eq.bt.filters": {
      "type": "as",
      "default": ["preamp 0"],
      "max_items": 11,
      "validator": "eq_filters",
      "applier": null,
      "group": "audio",
      "label": "Bluetooth EQ filters",
      "ui": {"widget": "none"}
    },
    "audio.bt_codec": {
      "type": "s",
      "default": "auto",
      "enum": ["auto", "aptx", "aac", "ldac", "sbc"],
      "applier": null,
      "group": "audio",
      "label": "Bluetooth codec",
      "ui": {"order": 5}
    },
    "display.orientation": {
      "type": "s",
      "default": "portrait",
      "enum": ["portrait", "portrait-flipped", "landscape", "landscape-flipped"],
      "applier": "ssc",
      "group": "display",
      "label": "Orientation",
      "ui": {"order": 0, "values": {"portrait-flipped": "portrait flipped", "landscape-flipped": "landscape flipped"}, "apply": "confirm", "lock": {"key": "display.auto_rotate", "is": true, "show": "display.rotation"}}
    },
    "display.auto_rotate": {
      "type": "b",
      "default": true,
      "applier": "ssc",
      "group": "display",
      "label": "Auto rotate",
      "ui": {"order": 1, "apply": "confirm"}
    },
    "display.rotation": {
      "type": "s",
      "default": "portrait",
      "enum": ["portrait", "portrait-flipped", "landscape", "landscape-flipped"],
      "writable": false,
      "applier": "ssc",
      "group": null,
      "label": "Current rotation"
    },
    "rgb.enabled": {
      "override": true,
      "type": "b",
      "default": false,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LEDs",
      "ui": {"order": 0}
    },
    "rgb.hue": {
      "override": true,
      "type": "u",
      "default": 0,
      "min": 0,
      "max": 359,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LED hue",
      "ui": {"order": 1, "widget": "hue", "lock": {"key": "rgb.enabled", "is": false, "text": "off"}}
    },
    "rgb.saturation": {
      "override": true,
      "type": "u",
      "default": 0,
      "min": 0,
      "max": 100,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LED saturation",
      "ui": {"order": 2, "step": 5, "unit": "%", "lock": {"key": "rgb.enabled", "is": false, "text": "off"}}
    },
    "rgb.brightness": {
      "type": "u",
      "default": 100,
      "min": 0,
      "max": 100,
      "applier": "rgb",
      "group": "rgb",
      "label": "Stick LED brightness",
      "ui": {"order": 3, "step": 5, "unit": "%", "lock": {"key": "rgb.enabled", "is": false, "text": "off"}}
    }
  },
  "groups": {
    "audio": {"label": "audio", "order": 0},
    "display": {"label": "display", "order": 1},
    "rgb": {"label": "stick leds", "order": 2},
    "power": {"label": "power", "order": 3},
    "system": {"label": "system", "order": 4}
  }
}
